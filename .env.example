# Copy this file to .env and fill in real values locally.

# Flask
FLASK_SECRET_KEY=replace-with-a-long-random-string

# SQL Server connection
# Either set SQLSERVER_CONNSTRING directly (full ODBC string, e.g. for
# Trusted_Connection setups), or fill in the individual fields below.
SQLSERVER_CONNSTRING=
SQLSERVER_DRIVER=ODBC Driver 17 for SQL Server
SQLSERVER_SERVER=localhost,1433
SQLSERVER_DATABASE=ArchiveDB
SQLSERVER_UID=
SQLSERVER_PWD=

# Registration-number prefix convention (e.g. "DOC" for "DOC-12345")
REG_NUMBER_PREFIX=DOC

# Shared/fallback SMTP account
SMTP_SERVER=smtp.office365.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=DocPortal System

# Fernet key for encrypting per-user SMTP credentials at rest.
# Generate once with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=

# Microsoft Graph (optional, replaces per-user SMTP login entirely)
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# USB scanner agent (optional)
SCANNER_IP=
